# App
NODE_ENV=development
AUTH_SESSION_SECRET=change-me-to-a-long-random-secret
# Optional: force cookie security flag (`true` or `false`). Leave empty for auto (HTTPS-aware).
AUTH_COOKIE_SECURE=
AUTH_ALLOW_DEV_ROLE_HEADER=false

# Gemini
GEMINI_API_KEY=

# Zoom OAuth
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
ZOOM_WEBHOOK_SECRET=

# Integration secret encryption (base64-encoded 32 bytes)
INTEGRATION_ENCRYPTION_KEY=

# Observability
OBSERVABILITY_ERROR_WEBHOOK_URL=

# Communications
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_AUTH_HEADER=Authorization
EMAIL_DELIVERY_WEBHOOK_AUTH_TOKEN=
EMAIL_DELIVERY_FROM_EMAIL=
EMAIL_DELIVERY_FROM_NAME=LinguistPro
APP_BASE_URL=

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/linguistpro?schema=public
RESTORE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/linguistpro_restore_test?schema=public
