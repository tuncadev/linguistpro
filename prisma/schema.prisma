datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum TutorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  QUIZ
  READING
}

model User {
  id              String  @id @default(cuid())
  name            String?
  email           String  @unique
  passwordHash    String?
  role            Role    @default(STUDENT)
  emailVerifiedAt DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  onboardingCompletedAt DateTime?
  welcomeDismissedAt DateTime?
  tutorApprovalStatus TutorApprovalStatus @default(PENDING)
  tutorApprovedAt DateTime?
  tutorApprovalNotes String?
  avatarUrl       String?
  bio             String?
  rating          Float?
  studentCount    Int?
  coursesAuthored Int?
  location        String?
  languagesSpoken String?
  profileHighlights Json?
  profileStats      Json?
  pedagogicalModules Json?

  authoredCourses Course[]     @relation("CourseTutor")
  enrollments     Enrollment[]
  authTokens      AuthToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthToken {
  id        String        @id @default(cuid())
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  consumedAt DateTime?
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Language {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  courses Course[]
}

model Level {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  courses Course[]
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  price       Decimal      @db.Decimal(10, 2)
  imageUrl    String?
  status      CourseStatus @default(DRAFT)
  publishedAt DateTime?
  submittedAt DateTime?
  reviewedAt  DateTime?
  archivedAt  DateTime?
  statusReason String?
  statusChangedById String?
  statusChangedAt DateTime?
  learningObjectives Json?
  enrollmentIncludes Json?
  tuitionLabel       String? @default("Tuition Fee")
  discountLabel      String? @default("65% Off Enrollment")
  courseDirectorLabel String? @default("Course Director")

  tutor   User   @relation("CourseTutor", fields: [tutorId], references: [id])
  tutorId String

  language   Language @relation(fields: [languageId], references: [id])
  languageId String

  level   Level  @relation(fields: [levelId], references: [id])
  levelId String

  studentCount Int   @default(0)
  rating       Float @default(0)
  reviews      Int   @default(0)

  syllabusSections SyllabusSection[]
  enrollments      Enrollment[]
  lifecycleEvents  CourseLifecycleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseLifecycleEvent {
  id        String       @id @default(cuid())
  courseId  String
  fromStatus CourseStatus?
  toStatus  CourseStatus
  reason    String?
  actorId   String
  actorRole Role
  metadata  Json?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model SyllabusSection {
  id       String @id @default(cuid())
  title    String
  position Int

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  lessons Lesson[]
}

model Lesson {
  id              String     @id @default(cuid())
  title           String
  durationSeconds Int?
  type            LessonType
  content         String?    @db.Text
  position        Int

  section   SyllabusSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String
}

model Enrollment {
  id String @id @default(cuid())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?  @db.Text
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
